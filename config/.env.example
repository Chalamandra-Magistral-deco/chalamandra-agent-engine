# La API solo recibe la clave pública. Nunca pongas la semilla privada en este archivo.
CHALAMANDRA_VERIFIER_PUBLIC_KEY=replace-with-64-hex-characters-in-the-agents-api-process
CHALAMANDRA_VERIFIER_ID=independent-verifier-identity

# Required integrity key: 32 random bytes encoded as 64 hexadecimal characters.
# Configure the exact same value in config/.env (API) and config/worker.env (worker).
# Never commit the real key; unsigned/legacy candidate records are rejected.
CHALAMANDRA_CANDIDATE_HMAC_KEY=replace-with-exactly-64-hex-characters

# JWT separados: el JWT general no autoriza el despacho de CatedralX.
CHALAMANDRA_JWT_SECRET=replace-with-an-independent-random-secret-of-at-least-32-bytes
CHALAMANDRA_CATEDRALX_JWT_SECRET=replace-with-a-different-independent-random-secret-of-at-least-32-bytes
# Dedicated product-to-engine identity; do not reuse either JWT secret above.
CHALAMANDRA_MAGIS_JWT_SECRET=replace-with-a-third-independent-random-secret-of-at-least-32-bytes
# Product-scoped model execution; does not enable general /v1/tasks.
CHALAMANDRA_MAGIS_EXECUTION_ENABLED=false

# W3C-correlated API access traces (no request bodies or credentials).
CHALAMANDRA_TRACE_LOG_PATH=/home/chalamandra/.local/state/chalamandra/agents/traces.jsonl

# Model providers. Ollama local remains the default and has no API key.
# Ollama Cloud is disabled unless explicitly enabled.
# OLLAMA_CLOUD_ENABLED=false
# OLLAMA_API_KEY=replace-with-your-ollama-api-key
# OLLAMA_CLOUD_MODEL=deepseek-v4.1-flash
# Prices are USD per million tokens (published peak defaults; editable).
# OLLAMA_CLOUD_INPUT_USD_PER_MILLION=0.30
# OLLAMA_CLOUD_OUTPUT_USD_PER_MILLION=1.20

# Ed25519 trust anchor for upstream market-data attestations.
# Configure the same public key and key ID in both API and worker environments.
# The matching private key belongs only to the upstream market-data provider.
CHALAMANDRA_MARKET_SOURCE_KEY_ID=replace-with-provider-key-id
CHALAMANDRA_MARKET_SOURCE_PUBLIC_KEY=replace-with-64-hex-character-ed25519-public-key
