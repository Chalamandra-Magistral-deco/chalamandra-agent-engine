# La API solo recibe la clave pública. Nunca pongas la semilla privada en este archivo.
CHALAMANDRA_VERIFIER_PUBLIC_KEY=replace-with-64-hex-characters-in-the-agents-api-process
CHALAMANDRA_VERIFIER_ID=independent-verifier-identity

# JWT separados: el JWT general no autoriza el despacho de CatedralX.
CHALAMANDRA_JWT_SECRET=replace-with-independent-random-secret
CHALAMANDRA_CATEDRALX_JWT_SECRET=replace-with-a-different-independent-random-secret
# Dedicated product-to-engine identity; do not reuse either JWT secret above.
CHALAMANDRA_MAGIS_JWT_SECRET=replace-with-another-independent-random-secret
# Product-scoped model execution; does not enable general /v1/tasks.
CHALAMANDRA_MAGIS_EXECUTION_ENABLED=false

# W3C-correlated API access traces (no request bodies or credentials).
CHALAMANDRA_TRACE_LOG_PATH=/home/chalamandra/.local/state/chalamandra/agents/traces.jsonl
