# Configuración de ejemplo para Chalamandra Agent Engine.
# Copia este archivo a config/.env y añade tus credenciales localmente.
# Nunca añadas credenciales reales al repositorio.

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Modelo local Ollama (sin coste de API)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Valores por defecto aplicados por ModelRequest
DEFAULT_TIMEOUT_SECONDS=60
DEFAULT_MAX_TOKENS=4096

# Directorio permitido para informes CSV de términos de búsqueda
CHALAMANDRA_SEARCH_TERMS_DIR=~/workspace/data/ads/search-terms

# Necesario solo si se consulta Azure Key Vault directamente
AZURE_KEYVAULT_URI=https://chalamandra-kv-2026.vault.azure.net/
