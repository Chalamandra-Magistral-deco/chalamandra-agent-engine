# Chalamandra Agents Environment Configuration
# Copy this file to .env and fill in your values. DO NOT commit .env.

# Webhook egress policy:
# Public webhook endpoints must use HTTPS and resolve only to public IP addresses.
# Private/loopback endpoints require an exact hostname allowlist entry.
# Example for an isolated Docker receiver only:
# CHALAMANDRA_WEBHOOK_PRIVATE_HOST_ALLOWLIST=receiver
# CHALAMANDRA_SSRF_ALLOW_LOCALHOST is deprecated and ignored by the hardened policy.

# CatedralX Integration (Optional, for read-only state access)
# CATEDRALX_PATH=/path/to/CatedralX/repo
# CATEDRALX_STATE_PATH=/home/user/.local/state/chalamandra/catedralx/hormonas.json

# LLM Provider API Keys (Uncomment and fill the one you are using)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# DEEPSEEK_API_KEY=sk-...

# LLM Model Overrides (Optional)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# Custom Paths (Optional)
# CHALAMANDRA_LEADS_PATH=/home/user/.local/state/chalamandra/leads.jsonl
# CHALAMANDRA_SEARCH_TERMS_DIR=/home/user/.local/state/chalamandra/search_terms
