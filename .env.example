# Chalamandra Agents Environment Configuration
# Copy this file to .env and fill in your values. DO NOT commit .env.

# Webhook egress policy:
# Public webhook endpoints must use HTTPS and resolve only to public IP addresses.
# Private/loopback endpoints require an exact hostname allowlist entry.
# Example for an isolated Docker receiver only:
# CHALAMANDRA_WEBHOOK_PRIVATE_HOST_ALLOWLIST=receiver
# CHALAMANDRA_SSRF_ALLOW_LOCALHOST is deprecated and ignored by the hardened policy.

# CatedralX Integration (Optional, for read-only state access)
# CATEDRALX_PATH=/path/to/CatedralX/repo
# CATEDRALX_STATE_PATH=/home/user/.local/state/chalamandra/catedralx/hormonas.json

# LLM Provider API Keys (Uncomment and fill the one you are using)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# DEEPSEEK_API_KEY=sk-...

# Ollama local (separate from the optional cloud adapter)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b

# Ollama Cloud is opt-in. The API uses the model ID without the :cloud CLI suffix.
# OLLAMA_CLOUD_ENABLED=false
# OLLAMA_API_KEY=replace-with-your-ollama-api-key
# OLLAMA_CLOUD_MODEL=deepseek-v4.1-flash
# Prices are USD per million tokens; defaults are current published peak rates.
# Adjust these when using off-peak pricing or if Ollama changes its rates.
# OLLAMA_CLOUD_INPUT_USD_PER_MILLION=0.30
# OLLAMA_CLOUD_OUTPUT_USD_PER_MILLION=1.20

# Custom Paths (Optional)
# CHALAMANDRA_LEADS_PATH=/home/user/.local/state/chalamandra/leads.jsonl
# CHALAMANDRA_SEARCH_TERMS_DIR=/home/user/.local/state/chalamandra/search_terms

# Market-data provenance: public key only; the provider signs source, timestamp,
# current_price and historical_prices using Ed25519. Private signing keys stay
# with the upstream provider and must never be placed in this repository.
# CHALAMANDRA_MARKET_SOURCE_KEY_ID=market-provider-key-v1
# CHALAMANDRA_MARKET_SOURCE_PUBLIC_KEY=replace-with-64-hex-character-ed25519-public-key
