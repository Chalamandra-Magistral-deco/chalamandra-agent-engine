[Unit]
Description=Reconcile verified business-cycle acceptance into CatedralX feedback
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=azureuser
WorkingDirectory=/home/azureuser/workspace/repos/agents
EnvironmentFile=/home/azureuser/.config/chalamandra/catedralx-dispatch.env
ExecStart=/home/azureuser/workspace/repos/agents/venv/bin/python /home/azureuser/workspace/repos/agents/scripts/reconcile_catedralx_feedback.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/azureuser/.local/state/chalamandra/agents /home/azureuser/.local/state/chalamandra/catedralx
