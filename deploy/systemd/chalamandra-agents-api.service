[Unit]
Description=Chalamandra Agent Engine local API
After=default.target

[Service]
Type=simple
User=azureuser
Group=azureuser
WorkingDirectory=/home/azureuser/workspace/repos/agents
Environment=PYTHONUNBUFFERED=1
Environment=CHALAMANDRA_API_HOST=127.0.0.1
Environment=CHALAMANDRA_API_PORT=8766
Environment=CHALAMANDRA_API_ENABLE_MODEL_CALLS=false
ExecStart=/home/azureuser/workspace/repos/agents/venv/bin/python -m api.server
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
RestrictSUIDSGID=true
ProtectHome=read-only
ReadWritePaths=/home/azureuser/.local/state/chalamandra
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
