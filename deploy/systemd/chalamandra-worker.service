[Unit]
Description=Chalamandra Task Worker
After=network.target

[Service]
Type=simple
User=azureuser
Group=azureuser
UMask=0077
WorkingDirectory=/home/azureuser/workspace/repos/agents
Environment=PYTHONPATH=/home/azureuser/workspace/repos/agents
Environment=CHALAMANDRA_WORKER_HEARTBEAT_PATH=/home/azureuser/.local/state/chalamandra/agents/worker_heartbeat.json
ExecStart=/home/azureuser/workspace/repos/agents/venv/bin/python -m api.worker_loop
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
