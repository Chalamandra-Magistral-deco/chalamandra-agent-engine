{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chalamandramagistral.com/contracts/acceptance/acceptance-decision.schema.json",
  "title": "Agents Independent Acceptance Decision",
  "description": "Signed acceptance decision produced only by the independent verifier. The signature covers the ten canonical fields, not the signature property itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "candidate_id",
    "outcome",
    "criteria_checked",
    "reasons",
    "missing_evidence",
    "verifier_id",
    "evidence_digest",
    "decided_at",
    "trace_id",
    "signature"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "outcome": {
      "type": "string",
      "enum": ["accepted", "rejected"]
    },
    "criteria_checked": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "verifier_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "evidence_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": "string",
      "description": "W3C trace-id: 16 bytes, lowercase hexadecimal, and not all zeroes.",
      "pattern": "^(?!0{32}$)[0-9a-f]{32}$"
    },
    "signature": {
      "type": "string",
      "description": "Ed25519 signature over the canonical ten-field payload, encoded as lowercase hexadecimal.",
      "pattern": "^[0-9a-f]{128}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": { "const": "accepted" }
        },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "criteria_checked": { "minItems": 1 },
          "reasons": { "maxItems": 0 },
          "missing_evidence": { "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": { "const": "rejected" }
        },
        "required": ["outcome"]
      },
      "then": {
        "anyOf": [
          { "properties": { "reasons": { "minItems": 1 } } },
          { "properties": { "missing_evidence": { "minItems": 1 } } }
        ]
      }
    }
  ]
}
